@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h2>Dashboard</h2>

<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="stat-card-value">$@Model.TotalRevenue.ToString("F0")</div>
            <div class="stat-card-label">Total Revenue</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="stat-card-value">@Model.TotalBooks</div>
            <div class="stat-card-label">Total Books</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="stat-card-value">@Model.TotalOrders</div>
            <div class="stat-card-label">Total Orders</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="stat-card-value">@Model.TotalCustomers</div>
            <div class="stat-card-label">Total Customers</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="stat-card-value">@Model.TotalReviews</div>
            <div class="stat-card-label">Total Reviews</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="stat-card-value">@Model.PendingOrders</div>
            <div class="stat-card-label">Pending Orders</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="stat-card-value">@Model.DeliveredOrders</div>
            <div class="stat-card-label">Delivered Orders</div>
        </div>
    </div>
</div>

@if (Model.MonthlySales.Any())
{
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card">
                <h5>Revenue</h5>
                <canvas id="revenueChart" height="200"></canvas>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <h5>Orders</h5>
                <canvas id="ordersChart" height="200"></canvas>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        var labels = [@Html.Raw(string.Join(",", Model.MonthlySales.Select(m => $"'{m.Month}'")))];

        var revCtx = document.getElementById('revenueChart');
        if (revCtx) {
            new Chart(revCtx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Revenue',
                        data: [@string.Join(",", Model.MonthlySales.Select(m => m.Revenue))],
                        backgroundColor: '#cc785c',
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true, ticks: { callback: function(v) { return '$' + v; } } } }
                }
            });
        }

        var ordCtx = document.getElementById('ordersChart');
        if (ordCtx) {
            new Chart(ordCtx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Orders',
                        data: [@string.Join(",", Model.MonthlySales.Select(m => m.Orders))],
                        borderColor: '#cc785c',
                        backgroundColor: 'rgba(204, 120, 92, 0.15)',
                        fill: true,
                        tension: 0.3,
                        pointRadius: 4,
                        pointBackgroundColor: '#cc785c'
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
                }
            });
        }
    </script>
}
