@model List<Category>
@{
    ViewData["Title"] = "Manage Categories";
}

<h2>Categories</h2>

<div class="card" style="margin-bottom: var(--space-lg); max-width: 400px;">
    <h5>Add Category</h5>
    <form method="post" action="/Admin/Categories/Create">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label class="form-label">Name</label>
            <input type="text" name="name" class="form-input" required />
        </div>
        <div class="form-group">
            <label class="form-label">Slug (optional)</label>
            <input type="text" name="slug" class="form-input" placeholder="leave empty to auto-generate" />
        </div>
        <button type="submit" class="btn btn-primary">Add Category</button>
    </form>
</div>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Slug</th>
                <th>Books</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cat in Model)
            {
                <tr>
                    <td><span style="font-weight: 500;">@cat.Name</span></td>
                    <td>@cat.Slug</td>
                    <td>@cat.Books.Count</td>
                    <td>
                        <form method="post" action="/Admin/Categories/Delete" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@cat.Id" />
                            <button type="submit" class="btn btn-text btn-sm" style="color: var(--color-error);" onclick="return confirm('Delete @cat.Name?')">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
