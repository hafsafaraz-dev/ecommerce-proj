@model Order
@{
    ViewData["Title"] = "Order Details";
}

<a href="/Admin/Orders" class="btn btn-text" style="margin-bottom: var(--space-md);">← Back to Orders</a>

<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-md); margin-bottom: var(--space-lg);">
    <div>
        <h2>Order @Model.OrderNumber</h2>
        <p class="text-muted">Placed by @(Model.User?.FullName ?? Model.User?.UserName ?? "Unknown") on @Model.OrderDate.ToString("MMM dd, yyyy")</p>
    </div>
    <span class="badge @(Model.Status == OrderStatus.Delivered ? "badge-success" : Model.Status == OrderStatus.Cancelled ? "badge-error" : "badge-warning")" style="font-size: 14px; padding: 6px 16px;">@Model.Status</span>
</div>

<div class="row">
    <div class="col-md-8 mb-4">
        <div class="card" style="margin-bottom: var(--space-md);">
            <h5>Items</h5>
            @foreach (var item in Model.OrderItems)
            {
                <div style="display: flex; align-items: center; gap: var(--space-md); padding: var(--space-sm) 0; border-bottom: 1px solid var(--color-hairline-soft);">
                    <div style="font-weight: 500; flex: 1;">@item.Book.Title</div>
                    <div style="font-size: 14px; color: var(--color-muted);">@item.Quantity × $@item.UnitPrice</div>
                    <div style="font-weight: 500;">$@((item.Quantity * item.UnitPrice).ToString("F2"))</div>
                </div>
            }
        </div>

        <div class="card">
            <h5>Update Status</h5>
            <div style="display: flex; flex-wrap: wrap; gap: var(--space-xs);">
                @foreach (OrderStatus status in Enum.GetValues<OrderStatus>())
                {
                    if (status == Model.Status) continue;
                    <form method="post" action="/Admin/Orders/UpdateStatus" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="status" value="@((int)status)" />
                        <button type="submit" class="btn btn-sm @(status == OrderStatus.Cancelled ? "btn-danger" : "btn-secondary")">Mark as @status</button>
                    </form>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card" style="margin-bottom: var(--space-md);">
            <h5>Order Summary</h5>
            <div style="display: flex; justify-content: space-between; margin-bottom: var(--space-sm);">
                <span class="text-muted">Total</span>
                <span style="font-weight: 500;">$@Model.TotalAmount.ToString("F2")</span>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: var(--space-sm);">
                <span class="text-muted">Payment</span>
                <span class="badge badge-success">@(Model.Payment?.Status ?? "N/A")</span>
            </div>
        </div>
        <div class="card">
            <h5>Shipping Address</h5>
            <p style="font-size: 14px; margin: 0;">@Model.ShippingAddress</p>
        </div>
    </div>
</div>
