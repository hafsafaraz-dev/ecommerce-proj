@model Order
@{
    ViewData["Title"] = "Order Details";
}

<section class="section">
    <div class="container">
        <a href="/Orders" class="btn btn-text" style="margin-bottom: var(--space-md);">← Back to Orders</a>

        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-md); margin-bottom: var(--space-lg);">
            <div>
                <h1 style="margin: 0;">Order @Model.OrderNumber</h1>
                <p class="text-muted">Placed on @Model.OrderDate.ToString("MMMM dd, yyyy")</p>
            </div>
            <span class="badge @(Model.Status == OrderStatus.Delivered ? "badge-success" : Model.Status == OrderStatus.Cancelled ? "badge-error" : "badge-warning")" style="font-size: 14px; padding: 6px 16px;">@Model.Status</span>
        </div>

        <div class="row">
            <div class="col-md-8 mb-4 mb-md-0">
                <div class="card">
                    <h5>Items</h5>
                    @foreach (var item in Model.OrderItems)
                    {
                        <div style="display: flex; align-items: center; gap: var(--space-md); padding: var(--space-sm) 0; border-bottom: 1px solid var(--color-hairline-soft);">
                            <div style="width: 50px; height: 67px; background: var(--color-surface-cream-strong); border-radius: var(--rounded-sm); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">📖</div>
                            <div style="flex: 1;">
                                <div style="font-weight: 500;">@item.Book.Title</div>
                                <div style="font-size: 13px; color: var(--color-muted);">Qty: @item.Quantity × $@item.UnitPrice.ToString("F2")</div>
                            </div>
                            <div style="font-weight: 500;">$@((item.Quantity * item.UnitPrice).ToString("F2"))</div>
                        </div>
                    }
                </div>
            </div>
            <div class="col-md-4">
                <div class="card" style="margin-bottom: var(--space-md);">
                    <h5>Order Summary</h5>
                    <div style="display: flex; justify-content: space-between; margin-bottom: var(--space-sm);">
                        <span class="text-muted">Subtotal</span>
                        <span>$@Model.TotalAmount.ToString("F2")</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: var(--space-sm);">
                        <span class="text-muted">Shipping</span>
                        <span>Free</span>
                    </div>
                    <hr style="border: none; border-top: 1px solid var(--color-hairline);" />
                    <div style="display: flex; justify-content: space-between;">
                        <span style="font-weight: 500;">Total</span>
                        <span style="font-family: var(--font-display); font-size: 22px;">$@Model.TotalAmount.ToString("F2")</span>
                    </div>
                </div>

                <div class="card">
                    <h5>Shipping Address</h5>
                    <p style="font-size: 14px; margin: 0;">@Model.ShippingAddress</p>
                </div>

                @if (Model.Payment != null)
                {
                    <div class="card" style="margin-top: var(--space-md);">
                        <h5>Payment</h5>
                        <div style="font-size: 14px;">
                            <span class="text-muted">Status: </span>
                            <span class="badge badge-success">@Model.Payment.Status</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
