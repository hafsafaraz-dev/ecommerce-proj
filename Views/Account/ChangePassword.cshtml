@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<section class="section">
    <div class="container" style="max-width: 440px; margin: 0 auto;">
        <h1 style="margin-bottom: var(--space-lg);">Change Password</h1>

        @if (!ViewData.ModelState.IsValid)
        {
            <div style="background: var(--color-error); color: white; padding: var(--space-sm) var(--space-md); border-radius: var(--rounded-md); margin-bottom: var(--space-md);">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <div class="card">
            <form method="post" action="/Account/ChangePassword">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label class="form-label">Current Password</label>
                    <input type="password" name="CurrentPassword" class="form-input" required />
                </div>
                <div class="form-group">
                    <label class="form-label">New Password</label>
                    <input type="password" name="NewPassword" class="form-input" required minlength="6" />
                </div>
                <div class="form-group">
                    <label class="form-label">Confirm New Password</label>
                    <input type="password" name="ConfirmPassword" class="form-input" required />
                </div>
                <button type="submit" class="btn btn-primary">Change Password</button>
                <a href="/Account/Profile" class="btn btn-secondary" style="margin-left: var(--space-xs);">Cancel</a>
            </form>
        </div>
    </div>
</section>
