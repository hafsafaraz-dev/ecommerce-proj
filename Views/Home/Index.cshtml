@model BookListViewModel
@{
    ViewData["Title"] = "BookBazaar";
    var featured = ViewBag.FeaturedBooks as List<Book> ?? new();
}

<section class="hero-band">
    <div class="container">
        <h1 class="display-xl" style="margin-bottom: var(--space-md);">Discover Your Next Favorite Book</h1>
        <p class="text-muted" style="font-size: 18px; max-width: 480px; margin-bottom: var(--space-lg);">
            Browse thousands of books across every genre. Read reviews, build your wishlist, and enjoy seamless checkout.
        </p>
        <div style="display: flex; gap: var(--space-sm); flex-wrap: wrap;">
            <a href="/Books" class="btn btn-primary btn-lg">Browse Books</a>
            <a href="/Books?sort=rating" class="btn btn-secondary btn-lg">Top Rated</a>
        </div>
    </div>
</section>

@if (featured.Any())
{
    <section class="section bg-surface-soft">
        <div class="container">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-lg);">
                <h2>Featured Books</h2>
                <a href="/Books" class="btn btn-text">View all →</a>
            </div>
            <div class="featured-carousel">
                @foreach (var book in featured)
                {
                    <div class="book-card" style="min-width: 220px;">
                        <a href="/Books/Details/@book.Id" style="text-decoration: none; color: inherit;">
                            <div class="book-card-img">
                                @if (!string.IsNullOrEmpty(book.CoverImage))
                                {
                                    <img src="@book.CoverImage" alt="@book.Title" style="width: 100%; height: 100%; object-fit: cover;" />
                                }
                                else
                                {
                                    <span>📖</span>
                                }
                            </div>
                            <div class="book-card-body">
                                <h3 class="book-card-title">@book.Title</h3>
                                <p class="book-card-author">@book.Author</p>
                                <div class="book-card-price">$@book.Price.ToString("F2")</div>
                                <div class="star-rating" style="margin-top: 4px;">
                                    @for (int s = 1; s <= 5; s++)
                                    {
                                        <span class="@(s <= Math.Round(book.AverageRating) ? "" : "star-empty")">★</span>
                                    }
                                    <span style="font-size: 12px; color: var(--color-muted); margin-left: 4px;">(@book.ReviewsCount)</span>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>
}

<section class="section">
    <div class="container">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-lg);">
            <h2>Latest Arrivals</h2>
            <a href="/Books" class="btn btn-text">View all →</a>
        </div>
        <div class="book-grid">
            @foreach (var book in Model.Books)
            {
                <div class="book-card">
                    <a href="/Books/Details/@book.Id" style="text-decoration: none; color: inherit;">
                        <div class="book-card-img">
                            @if (!string.IsNullOrEmpty(book.CoverImage))
                            {
                                <img src="@book.CoverImage" alt="@book.Title" style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <span>📖</span>
                            }
                        </div>
                        <div class="book-card-body">
                            <h3 class="book-card-title">@book.Title</h3>
                            <p class="book-card-author">@book.Author</p>
                            <div class="book-card-price">$@book.Price.ToString("F2")</div>
                            <div class="star-rating" style="margin-top: 4px;">
                                @for (int s = 1; s <= 5; s++)
                                {
                                    <span class="@(s <= Math.Round(book.AverageRating) ? "" : "star-empty")">★</span>
                                }
                                <span style="font-size: 12px; color: var(--color-muted); margin-left: 4px;">(@book.ReviewsCount)</span>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<section class="section bg-surface-card">
    <div class="container text-center">
        <h2 style="font-size: 36px; margin-bottom: var(--space-md);">Ready to Start Reading?</h2>
        <p style="font-size: 18px; color: var(--color-muted); margin-bottom: var(--space-lg); max-width: 500px; margin-left: auto; margin-right: auto;">
            Create an account to build your wishlist, write reviews, and track your orders.
        </p>
        <a href="/Account/Register" class="btn btn-primary btn-lg">Create Account</a>
    </div>
</section>
